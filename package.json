{
  "name": "codecard",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:mobile": "node scripts/start.mjs --mobile",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:migrate": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "db:seed": "tsx supabase/seed.ts",
    "security:scan": "node scripts/check-secrets.js",
    "security:audit": "node scripts/security-audit.mjs"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "brace-expansion": "^1.1.18",
    "fflate": "0.8.3",
    "image-size": "2.0.3",
    "js-yaml": "4.3.2",
    "prettier": "^3.4.2",
    "qs": "6.16.0",
    "tsx": "^4.19.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "nanoid": "3.3.11",
    "postcss": "8.5.26",
    "fflate": "0.8.3",
    "three-stdlib": {
      "fflate": "0.6.11"
    },
    "metro": {
      "image-size": "2.0.3"
    },
    "image-size": "2.0.3",
    "js-yaml": "4.3.2",
    "qs": "6.16.0",
    "@xmldom/xmldom": "0.9.12",
    "sharp": "0.35.4",
    "uuid": "11.1.1",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "packageManager": "npm@10.9.0"
}
