{
  "name": "codecard",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:mobile": "node scripts/start.mjs --mobile",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:migrate": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "db:seed": "tsx supabase/seed.ts",
    "security:scan": "node scripts/check-secrets.js",
    "security:audit": "node scripts/security-audit.mjs"
  },
  "devDependencies": {
    "brace-expansion": "^5.0.9",
    "prettier": "^3.4.2",
    "tsx": "^4.23.11",
    "turbo": "^2.10.9",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "nanoid": "3.3.11",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "packageManager": "npm@10.9.0"
}
